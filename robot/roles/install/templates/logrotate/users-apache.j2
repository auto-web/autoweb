# Apache logs of the users (roles/create_user/tasks/logs.yml), shown read-only in their ~/logs
/var/log/apache2/autoweb/*/access.log {
	daily
	missingok
	rotate 14
	# Also rotated when bigger, but only when logrotate runs (logrotate.timer: daily on Debian)
	maxsize 100M
	compress
	delaycompress
	notifempty
	create 644 root adm
	sharedscripts
	postrotate
                if /etc/init.d/apache2 status > /dev/null ; then \
                    /etc/init.d/apache2 reload > /dev/null; \
                fi;
	endscript
	prerotate
		if [ -d /etc/logrotate.d/httpd-prerotate ]; then \
			run-parts /etc/logrotate.d/httpd-prerotate; \
		fi; \
	endscript
}

