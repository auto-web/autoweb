<VirtualHost *:80>
	ServerName {{ configs.domain_users }}
	RedirectPermanent / https://{{ configs.domain_users }}/
</VirtualHost>

<VirtualHost *:443>
	Servername {{ configs.domain_users }}
	DocumentRoot /opt/autoweb/interface

	<Directory /opt/autoweb/interface>
		Options FollowSymLinks
		DirectoryIndex index.php
		Require all granted

		<IfModule mod_fcgid.c>
			<FilesMatch "\.php$">
				SetHandler fcgid-script
			</FilesMatch>
			FCGIWrapper /var/www/fcgi-scripts/autoweb_webadmin/php-fcgi-starter .php
			Options +ExecCGI
		</IfModule>

	</Directory>

	# Internal files are never served: code, templates, dependencies, robot, SQL and project files
	<FilesMatch "^(composer\.(json|lock)|config\.php|phinx\.php|.*\.(sql|md|twig)|\..*)$">
		Require all denied
	</FilesMatch>

	<Directory /opt/autoweb/interface/db>
		Require all denied
	</Directory>

	<Directory /opt/autoweb/interface/lib>
		Require all denied
	</Directory>

	<Directory /opt/autoweb/interface/robot>
		Require all denied
	</Directory>

	<Directory /opt/autoweb/interface/templates>
		Require all denied
	</Directory>

	<Directory /opt/autoweb/interface/vendor>
		Require all denied
	</Directory>

	# Front-end libraries installed by Composer: only their dist files are served
	# (a <Directory> with a longer path is merged last, so it reopens access)
	Alias /assets/bootstrap /opt/autoweb/interface/vendor/twbs/bootstrap/dist
	<Directory /opt/autoweb/interface/vendor/twbs/bootstrap/dist>
		Require all granted
	</Directory>

	Alias /assets/jquery /opt/autoweb/interface/vendor/components/jquery
	<Directory /opt/autoweb/interface/vendor/components/jquery>
		Require all granted
	</Directory>

	<IfModule mod_fcgid.c>
		SuexecUserGroup autoweb_webadmin autoweb_webadmin
		IPCCommTimeout  7200
	</IfModule>

	<IfModule mod_rewrite.c>
	RewriteEngine on
	RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization},L]
	</IfModule>

	# SSL Configuration
	SSLEngine On
	SSLProtocol All -SSLv2 -SSLv3
	SSLCertificateKeyFile  /etc/letsencrypt/live/{{ configs.domain_users }}/privkey.pem
	SSLCertificateFile     /etc/letsencrypt/live/{{ configs.domain_users }}/fullchain.pem

	ErrorLog /var/log/apache2/error.log

</VirtualHost>

